{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_take_screenshot",
        "browser_resize",
        "browser_click",
        "browser_type",
        "browser_press_key",
        "browser_wait_for"
      ]
    }
  }
}
