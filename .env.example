# Variables de entorno de ejemplo para Bistro POS
# Copia este archivo como .env y rellena con tus credenciales

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_APP_ID=tu_firebase_app_id

# Búsqueda de códigos de barras (opcional / integraciones externas)
VITE_GOUPC_API_KEY=tu_goupc_api_key
VITE_GOOGLE_CSE_API_KEY=tu_google_cse_api_key
VITE_GOOGLE_CSE_CX=tu_google_cse_cx

# Soporte / Notificaciones
VITE_DEVELOPER_EMAIL=dev@ejemplo.com
VITE_VAPID_PUBLIC_KEY=tu_vapid_public_key
